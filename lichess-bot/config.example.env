# Copie ce fichier en "config.env" et remplis-le. Ne partage JAMAIS ton token.
LICHESS_TOKEN=COLLE_TON_TOKEN_ICI
# Chemin vers Stockfish (sur Mac avec Homebrew : /opt/homebrew/bin/stockfish)
STOCKFISH_PATH=/opt/homebrew/bin/stockfish
# Temps de réflexion max par coup, en secondes
MAX_MOVE_TIME=5
# Threads et mémoire (Mo) pour Stockfish
THREADS=2
HASH=256
# Accepter les parties classées ? (true/false)
ACCEPT_RATED=true
